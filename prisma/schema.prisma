generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model boardstate {
  id         Int      @id @default(autoincrement())
  gameId     Int
  stateData  Json
  turnNumber Int
  createdAt  DateTime @default(now())
  game       game     @relation(fields: [gameId], references: [id], map: "BoardState_gameId_fkey")

  @@index([gameId], map: "BoardState_gameId_fkey")
}

model game {
  id         Int          @id @default(autoincrement())
  status     String // 'waiting', 'active', 'finished'
  maxPlayers Int          @default(4) // Configurable player limit
  createdBy  Int? // Optional: track who created the game
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  boardstate boardstate[]
  move       move[]
  player     player[]
}

model move {
  id        Int      @id @default(autoincrement())
  gameId    Int
  playerId  Int
  moveType  String
  moveData  Json
  createdAt DateTime @default(now())
  game      game     @relation(fields: [gameId], references: [id], map: "Move_gameId_fkey")
  player    player   @relation(fields: [playerId], references: [id], map: "Move_playerId_fkey")

  @@index([gameId], map: "Move_gameId_fkey")
  @@index([playerId], map: "Move_playerId_fkey")
}

enum TowerPosition {
  NORTH_WEST = '
  NORTH_EAST
  SOUTH_WEST
  SOUTH_EAST
}

model player {
  id        Int           @id @default(autoincrement())
  userId    Int
  gameId    Int
  tower     TowerPosition
  turnOrder Int
  joinedAt  DateTime      @default(now())
  move      move[]
  game      game          @relation(fields: [gameId], references: [id], map: "Player_gameId_fkey")
  user      user          @relation(fields: [userId], references: [id], map: "Player_userId_fkey")

  @@index([gameId], map: "Player_gameId_fkey")
  @@index([userId], map: "Player_userId_fkey")
}

model user {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique(map: "User_email_key") // Optional for guest users
  isGuest   Boolean  @default(true) // Track if user is a guest
  sessionId String?  @unique // For session tracking
  lastSeen  DateTime @default(now()) // Track activity
  createdAt DateTime @default(now())
  player    player[]
}
