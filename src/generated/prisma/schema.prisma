generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  players   Player[]
}

model Game {
  id          Int          @id @default(autoincrement())
  status      String // e.g. 'waiting', 'active', 'finished'
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  players     Player[]
  moves       Move[]
  boardStates BoardState[]
}

model Player {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    Int
  color     String // e.g. 'red', 'blue', 'yellow', 'purple'
  turnOrder Int
  joinedAt  DateTime @default(now())
  moves     Move[]
}

model Move {
  id        Int      @id @default(autoincrement())
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    Int
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  Int
  moveType  String // e.g. 'place', 'block', 'wind', etc.
  moveData  Json // details of the move
  createdAt DateTime @default(now())
}

model BoardState {
  id         Int      @id @default(autoincrement())
  game       Game     @relation(fields: [gameId], references: [id])
  gameId     Int
  stateData  Json // board layout, fire, wind, etc.
  turnNumber Int
  createdAt  DateTime @default(now())
}
